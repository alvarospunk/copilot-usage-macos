#!/usr/bin/expect -f

proc parsePlan {text} {
    regsub -all {\x1b\[[0-?]*[ -/]*[@-~]} $text "" text
    if {[regexp {\mPlan\M[^\r\n]*?([0-9]+([.][0-9]+)?)% used} $text matched percentage] && $percentage <= 100} {
        return "$percentage%"
    }
    return ""
}

if {$argc == 1 && [lindex $argv 0] eq "--parse"} {
    set percentage [parsePlan [read stdin]]
    if {$percentage eq ""} {
        puts stderr "No Plan percentage found."
        exit 1
    }
    puts $percentage
    exit 0
}

if {$argc != 0} {
    puts stderr "Usage: expect cli-plan-percent.exp"
    exit 2
}

set timeout 45
log_user 0
match_max 262144
if {[catch {spawn -noecho env NO_COLOR=1 TERM=xterm-256color copilot -i /usage}]} {
    puts stderr "Could not start Copilot CLI. Check that copilot is installed and authenticated."
    exit 1
}
set childPid [exp_pid]
catch {stty rows 40 columns 160 < $spawn_out(slave,name)}
set percentage ""
expect {
    -re {Plan[^\r\n]*% used} {
        set percentage [parsePlan $expect_out(buffer)]
        if {$percentage eq ""} {
            exp_continue -continue_timer
        }
    }
    timeout {
        puts stderr "Timed out waiting for Copilot Plan usage. Run copilot -i /usage to check authentication or startup prompts."
    }
    eof {
        puts stderr "Copilot exited before showing Plan usage."
    }
}
catch {exec kill -KILL $childPid}
catch {close}
catch {wait}
if {$percentage eq ""} {
    exit 1
}
puts $percentage
